# Credentials — NEVER commit these
.env
*.pem
checkpoints/access_token.json

# Checkpoints — runtime state, never commit (EC2 pulls from S3; local reads from disk)
checkpoints/*.json
checkpoints/short_wr_opt/*.json

# Data files (too large for git — re-download on AWS via data pipeline)
data/stocks/
data/raw/

# Claude Code project settings (personal/local)
.claude/

# Runtime logs (regenerated automatically)
logs/

# Jupyter checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/
.eggs/

# Tests
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Index parquet data (too large — lives in S3)
data/index/

# Year-based trade log parquets (too large — lives in S3)
data/trade_logs/20*/

# Daily generated checkpoint files
checkpoints/access_token.json
checkpoints/instruments.json
checkpoints/watchlist_*.json
checkpoints/live_candles_*.json
checkpoints/progress.json
checkpoints/strategy_performance_*.json
